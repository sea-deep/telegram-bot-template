{
  "name": "telegram-bot-template",
  "version": "1.0.0",
  "description": "A production-ready template for creating Telegram bots using Telegraf and TypeScript",
  "keywords": [
    "telegram",
    "telegraf",
    "bot",
    "typescript",
    "esm"
  ],
  "license": "ISC",
  "author": "sea-deep",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "npm run build && node dist/index.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

